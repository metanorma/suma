<urn:iso:std:iso:10303:-2:ed-2:en:tech:gizmo_arm.gizmo_state.members.0> rdf:first <urn:iso:std:iso:10303:-2:ed-2:en:tech:gizmo_arm.gizmo_state.idle>;
