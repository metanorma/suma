<urn:iso:std:iso:10303:-2:ed-2:en:tech:gizmo_arm.calibrated_gizmo> a owl:Class;
  rdfs:label "calibrated_gizmo";
  rdfs:comment "sane_factor: calibration_factor > 0.0;";
  rdfs:isDefinedBy <urn:iso:std:iso:10303:-2:ed-2:en:tech:gizmo_arm>;
