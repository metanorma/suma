  rdf:rest <urn:iso:std:iso:10303:-2:ed-2:en:tech:gizmo_arm.gizmo_state.members.2> .

<urn:iso:std:iso:10303:-2:ed-2:en:tech:gizmo_arm.gizmo_state.members.2> rdf:first <urn:iso:std:iso:10303:-2:ed-2:en:tech:gizmo_arm.gizmo_state.stopped>;
